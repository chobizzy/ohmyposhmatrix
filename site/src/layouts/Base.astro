---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { u } from '../data/url';
import TopBar from '../components/TopBar.astro';
import PromptBar from '../components/PromptBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  path?: string; // the prompt's [path] segment for this page
  dirty?: boolean; // start the prompt's git segment dirty (404)
  shell?: string; // the shell this page is about (inner guides)
  finale?: boolean; // the rain-written footer finale
}
const { title, description = site.description, path = '~', dirty = false, shell, finale = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u('/og.png'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: site.name,
  description: site.description,
  url: site.url,
  codeRepository: site.repo,
  programmingLanguage: 'JSON',
  runtimePlatform: 'oh-my-posh',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: site.author, url: `https://github.com/${site.author}` },
};
// One family, three files split by unicode-range: text, the ✓ ✗ arrows, and the Nerd Font icons.
const fonts = `
@font-face{font-family:'JBM';src:url('${u('/fonts/jbm-100_800-normal.woff2')}') format('woff2');font-weight:100 800;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'JBM';src:url('${u('/fonts/jbm-symbols.woff2')}') format('woff2');font-weight:100 800;font-display:swap;unicode-range:U+2192,U+2197,U+2588,U+2713,U+2717}
@font-face{font-family:'JBM';src:url('${u('/fonts/nf-icons.woff2')}') format('woff2');font-weight:100 800;font-display:block;unicode-range:U+E0A0,U+E62A,U+F179,U+F17C}`;
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The word matrix written in falling green source code on black" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={u('/fonts/jbm-100_800-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fonts}></style>
    <!-- Before first paint: flag JS + motion so hidden-until-revealed states never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      // The typed intro plays once per session; later hard loads just write the word.
      try { if (sessionStorage.getItem('omp-seen')) document.documentElement.classList.add('seen'); sessionStorage.setItem('omp-seen', '1'); } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="gl" transition:persist="gl" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__cols"></div></div>
    <TopBar />
    <main id="main" tabindex="-1" data-path={path} data-dirty={dirty ? '' : undefined} data-shell={shell}>
      <slot />
    </main>
    <Footer shell={shell} finale={finale} />
    <div class="bar-host" transition:persist="bar"><PromptBar path={path} dirty={dirty} /></div>
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
